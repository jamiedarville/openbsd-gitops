# ./setup writes .env for you. To write it by hand, copy this file and fill it in.

# Where the deployer gets the configuration from.
REPO_URL=git@github.com:YOUR-NAME/YOUR-REPO.git
BRANCH=main
# Seconds between checks for a new commit.
INTERVAL=60

# The deployment key for the firewall, and the firewall's pinned host key.
FW_SSH_KEY_FILE=/home/you/fcc-runner/id_ed25519
FW_KNOWN_HOSTS_FILE=/home/you/fcc-runner/known_hosts

# For a private repository: a read-only deploy key registered on GitHub, and
# GitHub's SSH host keys (the README shows how to fetch them).
GIT_SSH_KEY_FILE=/home/you/.ssh/openbsd-gitops-deploy-key
GIT_KNOWN_HOSTS_FILE=/home/you/fcc-runner/git_known_hosts

# Only for the monitoring deployer (docker compose --profile monitoring), and
# added by ./setup-monitoring: the key for the monitoring server, that server's
# pinned host key, and the file of secrets for the stack. The last line is the
# seconds between its checks for a new commit.
#MON_SSH_KEY_FILE=/home/you/fcc-runner/monitoring_ed25519
#MON_KNOWN_HOSTS_FILE=/home/you/fcc-runner/monitoring_known_hosts
#MON_SECRETS_FILE=/home/you/fcc-runner/monitoring-secrets.yml
#MON_INTERVAL=300

# The user that owns the key files above (run `id -u` and `id -g`).
DEPLOY_UID=1000
DEPLOY_GID=1000
