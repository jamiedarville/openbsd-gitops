# What Prometheus scrapes. Everything here runs on the monitoring server
# itself and listens on 127.0.0.1.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: grafana
    static_configs:
      - targets: ["127.0.0.1:3000"]

  - job_name: monitoring-node
    static_configs:
      - targets: ["127.0.0.1:9100"]
        labels:
          instance: "{{ monitoring.name }}"
